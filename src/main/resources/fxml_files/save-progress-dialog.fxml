<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="620.0" styleClass="save-dialog-root" stylesheets="@../css_files/saveProgressDialog.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cmsc13.ParadigmBreach.view.SaveProgressDialogController">
   <top>
      <HBox fx:id="header" alignment="CENTER_LEFT" spacing="12.0" styleClass="dialog-header">
         <children>
            <Label fx:id="dialogTitle" maxWidth="Infinity" styleClass="dialog-header-title" text="PARADIGMBREACH  //  SESSION CONTROL" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onCancel" prefHeight="26.0" prefWidth="25.0" styleClass="dialog-danger" text="X" />
         </children>
         <padding>
            <Insets bottom="10.0" left="16.0" right="12.0" top="10.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="10.0" styleClass="dialog-content">
         <children>
            <Label fx:id="heading" styleClass="dialog-heading" text="SAVE BEFORE EXIT?" />
            <Label fx:id="message" styleClass="dialog-message" text="Your current progress is only written when you choose a save slot." textAlignment="LEFT" wrapText="true" />
            <VBox fx:id="slotList" managed="false" spacing="9.0" visible="false" />
         </children>
         <padding>
            <Insets bottom="24.0" left="30.0" right="30.0" top="26.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="dialog-actions">
         <children>
            <Button fx:id="primaryButton" managed="false" maxHeight="25.0" mnemonicParsing="false" onAction="#onPrimary" styleClass="dialog-button, dialog-primary" text="SAVE PROGRESS" visible="false" HBox.hgrow="ALWAYS" />
            <Button fx:id="exitButton" managed="false" maxHeight="25.0" mnemonicParsing="false" onAction="#onExitWithoutSaving" styleClass="dialog-button, dialog-danger" text="EXIT WITHOUT SAVING" visible="false" HBox.hgrow="ALWAYS" />
            <Button fx:id="cancelButton" managed="false" maxHeight="25.0" mnemonicParsing="false" onAction="#onCancel" styleClass="dialog-button, dialog-secondary" text="CANCEL" visible="false" HBox.hgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="22.0" left="30.0" right="30.0" top="0.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
