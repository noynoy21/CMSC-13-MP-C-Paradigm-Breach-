<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" styleClass="terminal-root" stylesheets="@../css_files/terminalLook.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cmsc13.ParadigmBreach.view.CommandLineController">
   <center>
      <BorderPane prefHeight="200.0" prefWidth="200.0" styleClass="content" BorderPane.alignment="CENTER">
         <center>
            <TextArea fx:id="output" editable="false" prefHeight="200.0" prefWidth="200.0" styleClass="text-area" wrapText="true" BorderPane.alignment="CENTER" />
         </center>
         <bottom>
            <HBox prefHeight="9.0" prefWidth="600.0" styleClass="terminal-root" BorderPane.alignment="CENTER">
               <children>
                  <Label styleClass="prompt" text="&gt;" HBox.hgrow="ALWAYS" />
                  <TextField fx:id="input" onAction="#onEnter" prefHeight="0.0" prefWidth="240.0" styleClass="text-field" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </bottom>
      </BorderPane>
   </center>
   <left>
      <VBox prefHeight="400.0" prefWidth="190.0" styleClass="text-area" BorderPane.alignment="CENTER" />
   </left>
</BorderPane>
