<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" style="-fx-background-color: #0c0c0c;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cmsc13.ParadigmBreach.view.SaveFileSelectionController">
   <children>
      <VBox alignment="CENTER" spacing="18.0" style="-fx-padding: 36;" maxWidth="560.0">
         <children>
            <Label style="-fx-text-fill: #33ff33; -fx-font-family: 'Cascadia Mono'; -fx-font-size: 20px; -fx-font-weight: bold;" text="SELECT A SAVE FILE" />
            <Label style="-fx-text-fill: #9e9e9e; -fx-font-family: 'Cascadia Mono'; -fx-font-size: 13px;" text="Choose a saved session to continue, or start a new session." textAlignment="CENTER" wrapText="true" />
            <VBox fx:id="slotList" spacing="10.0" maxWidth="480.0" />
            <Button fx:id="newSessionButton" mnemonicParsing="false" onAction="#onNewSession" style="-fx-background-color: rgba(255, 255, 255, 0.06); -fx-text-fill: #dddddd; -fx-font-family: 'Cascadia Mono'; -fx-font-size: 14px; -fx-border-color: #777777; -fx-padding: 10 18;" text="START A NEW SESSION" />
         </children>
      </VBox>
   </children>
</StackPane>
